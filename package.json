{
  "name": "carsxe-mcp-server",
  "version": "0.0.0",
  "private": true,
  "main": "build/index.js",
  "bin": {
    "carsxe": "./build/index.js"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "build": "tsc && chmod 755 build/index.js",
    "build:cf": "tsc && chmod 755 build/index.js",
    "build:gcp": "tsc -p tsconfig.gcp.json --noEmit && esbuild src/index.gcp.ts --bundle --platform=node --target=node22 --outfile=dist/gcp/server.js --format=cjs",
    "dev": "wrangler dev",
    "format": "biome format --write",
    "lint:fix": "biome lint --fix",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/ui/appsUiMeta.test.ts src/ui/cards.test.ts src/tools/annotations.test.ts",
    "preview:ui": "tsx src/ui/writePreviews.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.40",
    "@modelcontextprotocol/sdk": "1.20.2",
    "agents": "^0.0.100",
    "dotenv": "^17.0.1",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@types/node": "^24.0.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "wrangler": "^4.27.0"
  }
}
